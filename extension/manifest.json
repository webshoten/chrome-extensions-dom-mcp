{
  "manifest_version": 3,
  "name": "Chrome Bridge MCP",
  "version": "0.1.0",
  "description": "Connects the active Chrome profile to the local Bridge helper.",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["console_capture.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["page_console_hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Chrome Bridge"
  },
  "permissions": ["alarms", "scripting", "tabs", "webRequest"],
  "host_permissions": ["http://127.0.0.1:9333/*", "ws://127.0.0.1:9333/*", "<all_urls>"]
}
