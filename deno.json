{
  "name": "chrome-bridge-mcp",
  "version": "0.1.0",
  "exports": "./src/desktop/main.ts",
  "tasks": {
    "check": "deno check --desktop src/desktop/main.ts",
    "test": "deno test --allow-net=127.0.0.1:9333",
    "desktop:dev": "deno desktop --hmr --allow-net=127.0.0.1:9333 --allow-env=HOME,PATH,DENO_SERVE_ADDRESS --allow-read --allow-write --allow-run --include=src/desktop/assets/tray-icon.png --include=src/desktop/assets/tray-icon-dark.png src/desktop/main.ts",
    "build:macos": "scripts/build-desktop-macos.sh"
  },
  "desktop": {
    "app": {
      "name": "Bridge",
      "identifier": "com.webshoten.bridge"
    },
    "backend": "webview"
  },
  "fmt": {
    "include": ["src/**/*.ts", "experiments/**/*.ts"]
  }
}
